# SERVER-ONLY configuration. Never bundle in the Flutter desktop build.
# Place service account JSON outside the repo or in a gitignored path.

APP_ENV=development
FIREBASE_PROJECT_ID=witrack-dev
GOOGLE_APPLICATION_CREDENTIALS=./secrets/witrack-dev-admin.json
PORT=8787
ADMIN_PORTAL_ORIGIN=http://127.0.0.1:5173

# Bootstrap emails — enforced by Admin SDK scripts only (dev).
ADMIN_BOOTSTRAP_EMAILS=kodextech9@gmail.com,zainskodex@gmail.com
# Optional shared secret for bootstrap script (not an app login password).
BOOTSTRAP_TOKEN=

# Emulator (optional; does not equal real Google sign-in)
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
