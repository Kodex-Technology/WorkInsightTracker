# Copy to `.env` for local development. For a production build, configure
# `.env.production` beside the application executable.

APP_NAME=Witrack
APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000/api/

# Reserved for a future identity provider (unused)
ENABLE_GOOGLE_AUTH=false
ENABLE_LOCAL_DEV_AUTH=true

BACKEND_PROVIDER=none
ATTENDANCE_PROVIDER=none
ENABLE_ATTENDANCE_INTEGRATION=false
ENABLE_REMOTE_TRACKING_SYNC=false
ENABLE_REMOTE_POLICY_SYNC=false
