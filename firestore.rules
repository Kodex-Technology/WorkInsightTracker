rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'user';
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin';
    }

    // Devices: owner can read/write own device docs; admins can read all.
    match /devices/{deviceId} {
      allow read: if signedIn() &&
        (resource.data.firebaseUid == request.auth.uid || isAdmin());
      allow create, update: if signedIn() &&
        request.resource.data.firebaseUid == request.auth.uid &&
        (!('role' in request.resource.data));
      allow delete: if false;
    }

    // Versioned policies — clients read; only Admin SDK (admin portal API) writes.
    match /policies/{policyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /policy_meta/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Audit — append-only via Admin SDK; clients cannot spoof.
    match /audit_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // No client-writable role documents.
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
