# Production API base used by the WorkInsight web frontend.
APP_NAME=WorkInsight Tracker
APP_ENV=production
API_BASE_URL=https://kodex.workinsight.net/kodex-managment-system/api
ENABLE_GOOGLE_AUTH=false
ENABLE_LOCAL_DEV_AUTH=false
BACKEND_PROVIDER=none
ATTENDANCE_PROVIDER=none
ENABLE_ATTENDANCE_INTEGRATION=false
ENABLE_REMOTE_TRACKING_SYNC=false
ENABLE_REMOTE_POLICY_SYNC=false
